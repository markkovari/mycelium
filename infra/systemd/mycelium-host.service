[Unit]
Description=Mycelium wash host v2
Documentation=https://github.com/markkovari/mycelium
After=mycelium-nats.service
Requires=mycelium-nats.service

[Service]
Type=simple
EnvironmentFile=-/etc/mycelium/host.env
# wash creates state under HOME / XDG_*; redirect into the writable data dir
# so ProtectHome=true doesn't block it.
Environment=HOME=/var/lib/mycelium/wash
Environment=XDG_CONFIG_HOME=/var/lib/mycelium/wash/config
Environment=XDG_DATA_HOME=/var/lib/mycelium/wash/data
Environment=XDG_CACHE_HOME=/var/lib/mycelium/wash/cache
ExecStart=/usr/local/bin/wash host \
    --scheduler-nats-url nats://127.0.0.1:4222 \
    --data-nats-url nats://127.0.0.1:4222 \
    --http-addr 0.0.0.0:8080 \
    --oci-cache-dir /var/lib/mycelium/oci-cache \
    --non-interactive
Restart=on-failure
RestartSec=5

# Hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/mycelium /var/log/mycelium

# Resource caps
MemoryHigh=400M
MemoryMax=800M

[Install]
WantedBy=multi-user.target
