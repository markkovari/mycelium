[Unit]
Description=mycelium core (telegram poller, channel router, executor, agent, ...)
Documentation=https://github.com/markkovari/mycelium
Requires=mycelium-nats.service
After=mycelium-nats.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mycelium
Group=mycelium
EnvironmentFile=-/etc/mycelium/secrets.env
EnvironmentFile=-/etc/mycelium/mycelium-core.env
WorkingDirectory=/var/lib/mycelium
ExecStart=/usr/local/bin/mycelium-core
Restart=always
RestartSec=3s

# Hardening — mycelium-core only needs NATS + outbound HTTPS for the LLM
# and Telegram. No incoming sockets unless the gateway HTTP server is
# explicitly configured.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mycelium
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true

# Logging via journald.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
