package mycelium:telegram-out@0.1.0;

// Outbound Telegram bot replies.
// Subscribes mycelium.channel.telegram.out.{chat_id} via wasmcloud:messaging/handler.
// Calls Telegram Bot API via wasi:http/outgoing-handler.
world telegram-out {
    export wasmcloud:messaging/handler@0.2.0;

    import wasi:http/outgoing-handler@0.2.2;
    import wasi:http/types@0.2.2;
    import wasi:io/streams@0.2.2;
    import wasi:io/poll@0.2.2;
    import wasi:config/store@0.2.0-rc.1;
    import wasi:logging/logging@0.1.0-draft;
    import wasi:clocks/wall-clock@0.2.2;

    import mycelium:types/types@0.1.0;
}
