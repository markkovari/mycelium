package mycelium:channel-router@0.1.0;

// Per-channel normaliser + admin-command demux.
//
// Inputs (NATS):
//   mycelium.channel.telegram.raw — raw Telegram update JSON (from telegram-poller)
//
// Outputs (NATS):
//   mycelium.channel.in            — canonical channel-message JSON
//
// WIT side calls:
//   mycelium:agent/agent-registry::create  when text begins with "/agent create "
//
// One component per channel family for now (just Telegram). Add CLI / web /
// Slack adapters next to this, each emitting onto mycelium.channel.in.
world channel-router {
    export wasmcloud:messaging/handler@0.2.0;

    import wasi:logging/logging@0.1.0-draft;
    import wasi:clocks/wall-clock@0.2.2;
    import wasi:keyvalue/store@0.2.0-draft;
    import wasi:config/store@0.2.0-rc.1;
    import wasi:random/random@0.2.2;
    import wasmcloud:messaging/consumer@0.2.0;

    import mycelium:types/types@0.1.0;
    import mycelium:agent/agent-registry@0.1.0;
}
