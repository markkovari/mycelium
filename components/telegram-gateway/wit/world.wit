package mycelium:telegram-gateway@0.1.0;

world telegram-gateway {
    /// Receive Telegram webhook POST
    export wasi:http/incoming-handler@0.2.2;
    /// Receive outbound reply requests from NATS
    export wasmcloud:messaging/handler@0.2.0;

    import wasi:http/outgoing-handler@0.2.2;
    import wasi:http/types@0.2.2;
    import wasi:io/streams@0.2.2;
    import wasi:io/poll@0.2.2;
    import wasi:keyvalue/store@0.2.0-draft;
    import wasi:config/store@0.2.0-draft;
    import wasi:logging/logging@0.1.0-draft;
    import wasi:clocks/wall-clock@0.2.2;
    import wasmcloud:messaging/producer@0.2.0;

    import mycelium:types/types@0.1.0;
    import mycelium:channel/inbound@0.1.0;
    import mycelium:channel/outbound@0.1.0;
    import mycelium:pairing/pairing@0.1.0;
}
