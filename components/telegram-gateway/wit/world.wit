package mycelium:telegram-gateway@0.1.0;

// HTTP webhook receiver. Supports `/agent create` admin commands via in-workload
// WIT call to agent-registry. Outbound replies, pairing, and message fan-out belong
// to sibling components (telegram-out, session-bridge).
// v2 host limitation: cannot import wasmcloud:messaging/consumer.
world telegram-gateway {
    export wasi:http/incoming-handler@0.2.2;

    import wasi:http/types@0.2.2;
    import wasi:io/streams@0.2.2;
    import wasi:io/poll@0.2.2;
    import wasi:config/store@0.2.0-rc.1;
    import wasi:logging/logging@0.1.0-draft;
    import wasi:clocks/wall-clock@0.2.2;

    import mycelium:types/types@0.1.0;
    import mycelium:agent/agent-registry@0.1.0;
}
