package mycelium:mcp@0.1.0;

/// MCP-style provider: one component exposes N tools via list-tools + call-tool.
/// Same capability-gate rules as mycelium:tool/tool-provider — deny-by-default,
/// only imports the runner has linked are reachable.
interface mcp-provider {
    record tool-def {
        name: string,
        description: string,
        /// JSON Schema string (OpenAI function-calling `parameters` shape).
        input-schema: string,
    }

    record mcp-result {
        output-json: string,
        is-error: bool,
    }

    /// Return the list of tools this component exposes. Called once at install time.
    list-tools: func() -> list<tool-def>;

    /// Invoke a single tool by name. Arguments are a JSON object string.
    call-tool: func(name: string, arguments-json: string) -> result<mcp-result, string>;
}

world mcp-skill {
    export mcp-provider;

    import wasi:clocks/wall-clock@0.2.2;
    import wasi:clocks/monotonic-clock@0.2.2;
    import wasi:io/error@0.2.2;
    import wasi:io/streams@0.2.2;
    import wasi:io/poll@0.2.2;
    import wasi:http/outgoing-handler@0.2.2;
    import wasi:http/types@0.2.2;
    import wasi:random/random@0.2.2;
}
